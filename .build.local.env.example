# Copy to .build.local.env (gitignored) and adjust for your machine.
# Everything here is optional:
# - SDK is auto-detected under ~/Library/Application Support/Garmin/ConnectIQ/Sdks
# - KEY defaults to ./developer_key (place your Connect IQ signing key there, gitignored)

# SDK="/path/to/connectiq-sdk-mac-x.y.z"
# KEY="/path/to/developer_key"

# DEVICE="fenix7"
# OUT="bin/GarminSmokeLess.prg"
